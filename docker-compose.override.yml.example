# ============================================================
# UMOA Banking Intelligence — pgAdmin (OPTIONAL)
#
# Usage:
#   1. Copy this file to docker-compose.override.yml
#   2. docker-compose up -d
#   3. Access pgAdmin at http://localhost:5050
#      Login: the PGADMIN_DEFAULT_EMAIL / PGADMIN_DEFAULT_PASSWORD you set in .env
#
# This file is gitignored — it will NOT be committed.
# ============================================================

services:
  pgadmin:
    image: dpage/pgadmin4:8
    container_name: umoa_pgadmin
    restart: unless-stopped
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_DEFAULT_EMAIL:?set PGADMIN_DEFAULT_EMAIL in .env}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_DEFAULT_PASSWORD:?set PGADMIN_DEFAULT_PASSWORD in .env}
      PGADMIN_CONFIG_SERVER_MODE: "False"
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: "False"
    ports:
      - "127.0.0.1:5050:80"
    volumes:
      - pgadmin_data:/var/lib/pgadmin
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - umoa_network

volumes:
  pgadmin_data:
    driver: local
