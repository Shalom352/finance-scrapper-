# ============================================================
# UMOA Banking Intelligence
# Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control. Placeholders only below.
# ============================================================

# ----------------------------
# Application
# ----------------------------
# development | staging | production
# production: API docs disabled, CORS_ORIGINS must be explicit (no "*"), BACKEND_DEBUG=false
APP_ENV=development
# Mode of the Docker stack (docker-compose.yml): production unless set otherwise
DOCKER_APP_ENV=production
# Default language: fr or en
DEFAULT_LOCALE=fr

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=umoa_banking
POSTGRES_USER=umoa_user
POSTGRES_PASSWORD=

# Optional full DSN override (SQLAlchemy async). Leave empty to build it from POSTGRES_*.
# Example shape: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# PostgreSQL application name shown in pg_stat_activity
DB_APPLICATION_NAME=umoa_backend

# ----------------------------
# FastAPI / Backend
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
BACKEND_LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins (explicit origins in production)
CORS_ORIGINS=http://localhost:3000

# ----------------------------
# Frontend / Next.js
# ----------------------------
# Browser-side API URL (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL for server components (Docker: http://backend:8000). Optional.
INTERNAL_API_URL=
# Host port of the frontend container (docker compose)
FRONTEND_PORT=3000

# ----------------------------
# Scraping
# ----------------------------
# Max concurrent download workers
SCRAPER_CONCURRENCY=3
# Download timeout in seconds
SCRAPER_TIMEOUT=60
# Storage path for downloaded documents
DOCUMENTS_STORAGE_PATH=./data/downloads

# ----------------------------
# Automated Ingestion & Scheduling
# ----------------------------
# Enable background automated 2x/day ingestion scheduler
INGESTION_ENABLED=true
# Cron expression for automated runs (default: 08:00 and 20:00 every day)
INGESTION_SCHEDULE=0 8,20 * * *
# Timezone for schedule evaluation (e.g. Africa/Abidjan for UMOA zone)
INGESTION_TIMEZONE=Africa/Abidjan
# Number of historical calendar years to inspect (e.g. 5 = current year + 5 previous years)
INGESTION_HISTORICAL_YEARS=5
# Maximum number of ingestion tasks running at once
INGESTION_CONCURRENCY_LIMIT=1
# A run still "running" after N hours was interrupted: marked failed at start-up / before each run
INGESTION_STALE_RUN_HOURS=6

# Automated deal collection (migration 0020) — "deals" phase of every run, see docs/deal-intelligence.md §11
DEAL_COLLECTION_ENABLED=true
# Sources collected by the scheduled run: umoa-titres, brvm, amf-umoa, ifc, boad, proparco, bidc
# (+ "press" — Sika Finance, Ecofin, Financial Afrik — only once the publishers' terms are cleared)
DEAL_COLLECTION_SOURCES=umoa-titres,brvm,amf-umoa,ifc,boad,proparco,bidc
# Window of the scheduled run (pages published / modified in the last N days)
DEAL_COLLECTION_LOOKBACK_DAYS=120
# Minimum seconds between two requests to one host (a robots.txt Crawl-delay may raise it)
DEAL_COLLECTION_DELAY_SECONDS=2
# Pages read per source and per run at most (0 = no limit); the rest is read by the next runs
DEAL_COLLECTION_MAX_PAGES=200

# Automatic validation (Phase 21) — reversible by a human, see docs/data-quality.md §9
AUTO_VALIDATION_ENABLED=true
AUTO_VALIDATION_SCOPE_CLASSES=A,B,C
AUTO_VALIDATION_SINGLE_SOURCE_STATUS=reviewed

# Discovery engine (phases 15-17) — recurring run, see docs/discovery-engine.md
DISCOVERY_ENABLED=false
DISCOVERY_SCHEDULE=0 3 * * *
DISCOVERY_UNIVERSE=UMOA.BANKING
DISCOVERY_HISTORICAL_YEARS=5
DISCOVERY_FASCICLE_EDITIONS=1
# Number of reference-list editions inspected per discovery run
DISCOVERY_REFERENCE_EDITIONS=1
DISCOVERY_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
DISCOVERY_SEARCH_STORAGE_RIGHTS_CONFIRMED=false
DISCOVERY_SEARCH_RESULTS_PER_ENTITY=5
DISCOVERY_SEARCH_MAX_ENTITIES_PER_RUN=20

# Scanned institution-specific reports; OCR is disabled unless explicitly enabled.
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_LANGUAGE=fra+eng
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PAGES=40
DOCUMENT_OCR_TIMEOUT_SECONDS=45

# ----------------------------
# Syndication
# Maximum workbook accepted by the upload route, in bytes
SYNDICATION_MAX_UPLOAD_BYTES=15000000

# ----------------------------
# Access control
# ----------------------------
# Web interface: comma-separated "user:password" pairs checked by the Next.js middleware (required)
BASIC_AUTH_USERS=
# Shared secret between the Next.js proxy and the backend: required by every backend write route
# and by internal routes (syndication, contacts). Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
