# ============================================================
# UMOA Banking Intelligence
# Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control. Placeholders only below.
# ============================================================

# ----------------------------
# Application
# ----------------------------
# development | staging | production
# production: API docs disabled, CORS_ORIGINS must be explicit (no "*"), BACKEND_DEBUG=false
APP_ENV=development
# Default language: fr or en
DEFAULT_LOCALE=fr

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=umoa_banking
POSTGRES_USER=umoa_user
POSTGRES_PASSWORD=

# Optional full DSN override (SQLAlchemy async). Leave empty to build it from POSTGRES_*.
# Example shape: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# ----------------------------
# FastAPI / Backend
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
BACKEND_LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins (explicit origins in production)
CORS_ORIGINS=http://localhost:3000

# ----------------------------
# Frontend / Next.js
# ----------------------------
# Browser-side API URL (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL for server components (Docker: http://backend:8000). Optional.
INTERNAL_API_URL=
# Host port of the frontend container (docker compose)
FRONTEND_PORT=3000

# ----------------------------
# Scraping
# ----------------------------
# Max concurrent download workers
SCRAPER_CONCURRENCY=3
# Download timeout in seconds
SCRAPER_TIMEOUT=60
# Storage path for downloaded documents
DOCUMENTS_STORAGE_PATH=./data/downloads

# ----------------------------
# Automated Ingestion & Scheduling
# ----------------------------
# Enable background automated 2x/day ingestion scheduler
INGESTION_ENABLED=true
# Cron expression for automated runs (default: 08:00 and 20:00 every day)
INGESTION_SCHEDULE=0 8,20 * * *
# Timezone for schedule evaluation (e.g. Africa/Abidjan for UMOA zone)
INGESTION_TIMEZONE=Africa/Abidjan
# Number of historical calendar years to inspect (e.g. 5 = current year + 5 previous years)
INGESTION_HISTORICAL_YEARS=5

# Automatic validation (Phase 21) — reversible by a human, see docs/data-quality.md §9
AUTO_VALIDATION_ENABLED=false
AUTO_VALIDATION_SCOPE_CLASSES=A,B,C
