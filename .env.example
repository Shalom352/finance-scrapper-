# ============================================================
# UMOA Banking Intelligence
# Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=umoa_banking
POSTGRES_USER=umoa_user
POSTGRES_PASSWORD=change_me_in_production

# Full DSN (used by SQLAlchemy)
# Constructed from the above — override if needed
DATABASE_URL=postgresql+asyncpg://umoa_user:change_me_in_production@localhost:5432/umoa_banking

# ----------------------------
# FastAPI / Backend
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ----------------------------
# Frontend / Next.js
# ----------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------
# Scraping
# ----------------------------
# Max concurrent download workers
SCRAPER_CONCURRENCY=3
# Download timeout in seconds
SCRAPER_TIMEOUT=60
# Storage path for downloaded documents
DOCUMENTS_STORAGE_PATH=./data/downloads

# ----------------------------
# Application
# ----------------------------
APP_ENV=development
# Default language: fr or en
DEFAULT_LOCALE=fr
